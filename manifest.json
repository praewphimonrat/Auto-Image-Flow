{
  "manifest_version": 3,
  "name": "Google Labs Flow Helper",
  "description": "Empty scaffold for a Chrome extension that runs on Google Labs Flow project pages.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://labs.google/fx/th/tools/flow/project/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/th/tools/flow/project/*"
      ],
      "js": [
        "content.js",
        "flow-page-actions.js",
        "queue-panel.js",
        "test-background-automation.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
